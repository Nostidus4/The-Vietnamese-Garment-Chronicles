# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:3000
# Enables POST /admin/reload (send header X-Admin-Token). Leave empty to disable.
ADMIN_TOKEN=
TRYON_PER_MINUTE=6
MAX_UPLOAD_MB=8

# Anonymous usage events (POST /events, ticket #4). Leave empty locally: events then go to backend/data/events.jsonl.
# Service role key: Supabase → Project Settings → API. Server-side only, never in the frontend or in chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
